# Copy to apps/api/.env (`npm run setup` does this for you and generates JWT_SECRET).
# Never commit the real .env.

# Local dev: SQLite file, no database server needed.
# Production: paste your Postgres URL as-is, e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite:///./ajaia.db

# Signs session cookies. Use a long random value; changing it signs everyone out.
JWT_SECRET=7k7HUtLFnz2fDENELvK2_dadBQAam-IEc1wPcsX8qXZUMLrg09OEQfyluttTXAtH

# true in production (HTTPS only cookies); false for http://localhost
COOKIE_SECURE=false

# Only needed if the browser calls the API directly. By default the web app proxies /api/*,
# so this can stay as is.
CORS_ORIGINS=http://localhost:3000

# Max upload size in bytes (4 MB; Vercel rejects request bodies above ~4.5 MB)
# MAX_UPLOAD_BYTES=4194304
